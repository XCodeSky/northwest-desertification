  "markov": {
    "laplace_initial_count": 1.0,
    "recent_transition_weight": 2.0,
    "recent_transition_start_year_threshold": 2015,
    "older_transition_weight": 1.0,
    "class_order": ["稳定", "轻度", "中度", "重度", "极重度"],
    "transition_matrix": [
      [0.9393674321, 0.0580100144, 0.0024063723, 0.0001572530, 0.0000589282],
      [0.2625771979, 0.5755903263, 0.1576542999, 0.0041775954, 0.0000005805],
