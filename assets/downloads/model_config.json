  "proxy_label_rules": {
    "default_valid_class": 0,
    "cropland": [
      {"condition": "ndvi < 0.35", "class": 1},
      {"condition": "ndvi < 0.20", "class": 2}
    ],
    "shrub_or_grass": [
      {"condition": "ndvi < 0.45", "class": 1},
      {"condition": "ndvi < 0.30", "class": 2},
      {"condition": "ndvi < 0.18", "class": 3}
    ],
    "barren": [
      {"condition": "all barren cells", "class": 2},
      {"condition": "ndvi < 0.25", "class": 3},
      {"condition": "ndvi < 0.12", "class": 4}
    ],
    "warning": "Proxy labels derived from land cover and NDVI; not official ground-truth classes."
  },
  "features": [
    "current_class",
    "ndvi",
    "ndvi_5y_trend",
    "land_cover",
    "longitude",
    "latitude",
    "neighbor_non",
    "neighbor_light",
    "neighbor_moderate",
    "neighbor_severe",
    "neighbor_extreme"
  ],
  "feature_processing": {
    "ndvi_5y_trend": "clip((current_ndvi - previous_anchor_ndvi) / 5, -0.04, 0.04)",
    "neighborhood_window_cells": [15, 15],
    "neighborhood_nominal_footprint": "approximately 15 km x 15 km",
    "neighborhood_metric": "fraction of valid neighboring cells in each of five classes"
  },
  "training": {
    "algorithm": "LightGBM LGBMClassifier",
    "objective": "multiclass",
    "training_sample_count": 15701135,
    "samples_per_transition": 3140227,
    "transition_periods": ["2000-2005", "2005-2010", "2010-2015", "2015-2020", "2020-2025"],
    "validation_design": "Train on 2000-2020 transitions; hold out the complete 2020-2025 transition.",
    "validation_training_samples": 12560908,
    "validation_samples": 3140227,
    "validation_n_estimators": 420,
    "final_n_estimators": 520,
    "memory_store": {
      "features": "float32 memmap",
      "targets": "uint8 memmap"
    }
  },
  "lightgbm_parameters": {
    "boosting_type": "gbdt",
    "objective": "multiclass",
    "num_class": 5,
    "n_estimators": 520,
    "learning_rate": 0.055,
    "num_leaves": 64,
