      [0.0021980284, 0.0048949357, 0.1085466385, 0.8243836434, 0.0599767540],
      [0.0002638315, 0.0000332122, 0.0008722238, 0.0390330108, 0.9597977217]
    ]
  },
  "ca_markov": {
    "machine_learning_weight": 0.62,
    "markov_weight": 0.38,
    "neighborhood_base": 0.70,
    "neighborhood_weight": 0.30,
    "climate_exponential_weight": 0.08,
    "severity_axis": [-2, -1, 0, 1, 2],
    "base_formula": "0.62 * P_lightgbm + 0.38 * P_markov",
    "neighborhood_formula": "P_base * (0.70 + 0.30 * neighborhood_target_fraction)",
    "climate_formula": "P_neighbor * exp(0.08 * climate_pressure * severity_axis)",
    "allocation_score": "P_final(target) / max(P_final(source), 1e-9)",
    "allocation_mode": "deterministic highest-suitability allocation under Markov transition demand"
  },
  "climate": {
    "dataset": "NASA NEX-GDDP-CMIP6",
    "model": "IITM-ESM",
    "scenarios": ["SSP1-2.6", "SSP2-4.5", "SSP5-8.5"],
    "variables": ["pr", "tas"],
    "source_resolution": "0.25 degree daily, annual aggregation",
    "source_years": [2025, 2030, 2040, 2050],
    "scenario_execution": "Each scenario directly uses its own NEX-GDDP-CMIP6 precipitation and temperature fields while reusing the same trained LightGBM and CA-Markov configuration.",
    "interpolated_years": [2035, 2045],
    "baseline_year": 2025,
    "pressure_formula": "clip((tas_year - tas_2025)/3 - ((pr_year - pr_2025)/max(pr_2025,50))/0.50, -1, 1)",
    "spatial_mapping": "RegularGridInterpolator to model grid",
    "warning": "Interpolation to 0.01 degree does not create true 1 km climate information."
  },
  "future_predictors": {
    "ndvi_long_trend": "clip((ndvi_2025 - ndvi_2015) / 10, -0.012, 0.012)",
    "ndvi_five_year_update": "clip(current_ndvi + 5 * long_trend, -0.1, 0.95)",
    "land_cover": "fixed at the 2020 ESA CCI-derived class map during forecasts"
  },
  "annualization": {
    "method": "Rank changed cells by target/source suitability and divide into five near-equal transition batches.",
    "alpha": "step / 5",
    "probability_formula": "P_year = alpha * P_anchor; add (1-alpha) to the start class",
    "year_statuses": ["historical_anchor", "historical_interpolation", "forecast_anchor", "forecast_annualized"]
  },
